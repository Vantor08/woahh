<main class="cart-page"><a href="{{ routes.root_url }}">← Continue shopping</a><h1>Your cart</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line">{% if item.image %}{{ item.image | image_url: width: 200 | image_tag }}{% endif %}<div><h3>{{ item.product.title | escape }}</h3><p>{{ item.variant.title | escape }}</p>{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<p>{{ item.final_line_price | money }}</p><label>Quantity <input type="number" min="0" name="updates[]" value="{{ item.quantity }}"></label><a href="{{ item.url_to_remove }}">Remove</a></div></div>{% endfor %}<h2>Subtotal: {{ cart.total_price | money }}</h2><p>Taxes and shipping calculated at checkout.</p><button class="btn btn-ghost" type="submit" name="update">Update cart</button> <button class="btn" type="submit" name="checkout">Checkout</button></form>{% else %}<p>Your cart is empty.</p>{% endif %}</main>